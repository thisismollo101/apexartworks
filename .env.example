# ---- Supabase (server-only; NEVER use NEXT_PUBLIC_ for these) ----
# Project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
# Service role key — server routes + pipeline only. This bypasses RLS; it must
# never be exposed to a browser or committed.
SUPABASE_SERVICE_ROLE_KEY=
# Anon key — used ONLY by scripts/wall-audit.ts to prove the wall holds.
SUPABASE_ANON_KEY=

# ---- Admin prompt viewer ----
# CLOSED allowlist of admin emails, comma-separated, server-only. If missing
# or empty, NOBODY is admin (fail closed). Only these exact addresses may
# ever be admin.
ADMIN_EMAILS=
# Public pair for the login page ONLY. The anon key creates auth sessions and
# nothing else — every table is RLS deny-all, so a session grants zero data
# access. Same values as SUPABASE_URL / SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- The Gate (pipeline only, not needed at runtime) ----
ANTHROPIC_API_KEY=
# Optional overrides:
# GATE_MODEL=claude-sonnet-5
# DECOMPOSE_MODEL=claude-sonnet-5
